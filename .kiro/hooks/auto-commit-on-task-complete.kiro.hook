{
  "enabled": true,
  "name": "Auto-commit on Task Complete",
  "description": "Automatically stages and commits all changes to git after a spec task is marked as completed",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git diff --cached --quiet || git commit -m \"task: complete task from intake-flow spec\""
  }
}